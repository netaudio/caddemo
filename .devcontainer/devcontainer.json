{
    "name": "Qt GUI Codespaces",
    "image": "mcr.microsoft.com/devcontainers/cpp:ubuntu",
    "features": {
        "ghcr.io/devcontainers/features/desktop-lite:1": {
            "password": "vscode"
        }
    },
    "forwardPorts": [6080],
    "portsAttributes": {
        "6080": {
            "label": "Linux Desktop",
            "onAutoForward": "openBrowser"
        }
    }
}