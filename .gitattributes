# 默认按文本处理并自动识别换行
* text=auto

# ---- 必须保持 LF 的文件 ----
# 这些文件会进 Linux 容器执行；若变成 CRLF，bash 会报 $'\r': command not found
*.sh          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
Dockerfile    text eol=lf
*.cmake       text eol=lf
CMakeLists.txt text eol=lf

# ---- Windows 侧保留 CRLF ----
*.bat         text eol=crlf
*.cmd         text eol=crlf
*.ps1         text eol=crlf

# ---- 二进制，不做任何转换 ----
*.png         binary
*.jpg         binary
*.ico         binary
*.zip         binary
*.tar.gz      binary
*.dxf         binary
*.part2d      binary
